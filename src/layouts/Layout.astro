---
import "@/styles/global.css";
import type { Lang } from "@/data/resume";
import { meta } from "@/data/resume";

interface Props {
  title?: string;
  lang: Lang;
}

const { title = `${meta.name} — Portfolio`, lang } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Jose Enrique Narvaez — Founding Engineer & Tech Lead at Reveni. Building products from zero to scale." />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f2f4ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,600;0,700;1,400&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
