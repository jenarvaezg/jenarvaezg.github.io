---
import type { Lang } from "@/data/resume";
import { languages, nav } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="languages" class="px-6 py-24">
  <div class="mx-auto max-w-3xl">
    <h2 class="mb-8 font-heading text-3xl">
      {nav[lang].languages}
    </h2>

    <div class="flex gap-12">
      {languages.map((l) => (
        <div>
          <p class="text-lg font-semibold text-text-primary">{l.name[lang]}</p>
          <p class="text-sm text-text-secondary">{l.level[lang]}</p>
        </div>
      ))}
    </div>
  </div>
</section>
