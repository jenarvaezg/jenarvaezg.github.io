---
import type { Lang } from "@/data/resume";
import { experience, nav, ui } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const firstYear = Math.min(
  ...experience.map((job) => Number(job.period.match(/\d{4}/)?.[0] ?? Infinity)),
);
---

<section id="experience" class="border-t border-rule px-6 py-16 sm:py-20">
  <div class="mx-auto max-w-4xl">
    <div class="mb-10 flex items-baseline justify-between gap-4">
      <h2 class="font-heading text-2xl font-semibold sm:text-3xl">
        {nav[lang].experience}
      </h2>
      <span class="font-mono text-xs text-ink-soft">{firstYear} → {t.present}</span>
    </div>

    <div class="divide-y divide-rule">
      {experience.map((job) => (
        <article class="grid gap-2 py-7 first:pt-0 last:pb-0 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <p class="font-mono text-xs leading-6 text-ink-soft">
            {job.period}
          </p>
          <div>
            <h3 class="text-lg font-semibold text-ink">
              {job.role[lang]}
              <span class="font-normal text-ink-soft"> — {job.company}</span>
            </h3>
            {job.bullets && (
              <ul class="mt-3 space-y-1.5">
                {job.bullets[lang].map((bullet) => (
                  <li class="flex gap-2.5 text-sm leading-relaxed text-ink-soft">
                    <span class="mt-[0.65rem] h-px w-3 shrink-0 bg-market"></span>
                    {bullet}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
