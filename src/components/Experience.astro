---
import type { Lang } from "@/data/resume";
import { experience, nav } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="experience" class="px-6 py-24">
  <div class="mx-auto max-w-3xl">
    <h2 class="mb-12 font-heading text-3xl">
      {nav[lang].experience}
    </h2>

    <div class="relative border-l border-border pl-8">
      {experience.map((job) => (
        <div class="relative mb-10 last:mb-0">
          <div class="absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-accent bg-[#0c0a09]"></div>

          <p class="mb-1 text-xs font-medium tracking-wide text-text-secondary/60 uppercase">
            {job.period}
          </p>
          <h3 class="text-lg font-semibold text-text-primary">
            {job.role[lang]}
          </h3>
          <p class="mb-3 text-sm font-medium text-accent">
            {job.company}
          </p>
          {job.bullets && (
            <ul class="space-y-1.5">
              {job.bullets[lang].map((bullet) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-text-secondary/80">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-text-secondary/50"></span>
                  {bullet}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
