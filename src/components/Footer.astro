---
import { meta } from "@/data/resume";
---

<footer class="border-t border-rule px-6 py-8">
  <div class="mx-auto flex max-w-4xl items-center justify-between font-mono text-xs text-ink-soft">
    <p>© {new Date().getFullYear()} {meta.name} · {meta.location}</p>
    <div class="flex gap-5">
      <a href={meta.github} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-market">
        GitHub
      </a>
      <a href={meta.linkedin} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-market">
        LinkedIn
      </a>
    </div>
  </div>
</footer>
