---
import type { Lang } from "@/data/resume";
import { projects, adventOfCode, nav } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="projects" class="px-6 py-24">
  <div class="mx-auto max-w-3xl">
    <h2 class="mb-12 font-heading text-3xl">
      {nav[lang].projects}
    </h2>

    <div class="divide-y divide-border">
      {projects.map((project) => (
        <div class="py-5 first:pt-0 last:pb-0">
          <div class="mb-2 flex items-center justify-between">
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-semibold text-text-primary transition-colors hover:text-accent"
            >
              {project.name}
            </a>
            <div class="flex items-center gap-3">
              {project.stars > 0 && (
                <span class="flex items-center gap-1 text-xs text-text-secondary">
                  <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                  {project.stars}
                </span>
              )}
              <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-text-secondary transition-colors hover:text-accent">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25" /></svg>
              </a>
            </div>
          </div>
          <p class="mb-2 text-sm text-text-secondary">
            {project.description[lang]}
          </p>
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-surface px-2.5 py-1 text-xs text-text-secondary">
              {project.tech}
            </span>
            {project.homepage && (
              <a
                href={project.homepage}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-medium text-accent transition-colors hover:text-amber-500"
              >
                {lang === "en" ? "Live" : "Ver"} →
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

    {/* Advent of Code */}
    <div class="mt-12">
      <h3 class="mb-6 text-lg font-semibold text-text-primary">
        {lang === "en" ? "Advent of Code — (almost) a new language each year" : "Advent of Code — (casi) un lenguaje nuevo cada ano"}
      </h3>
      <div class="flex flex-wrap gap-3">
        {adventOfCode.map((entry) => (
          <a
            href={`https://github.com/jenarvaezg/${entry.year === 2019 || entry.year <= 2018 ? "adventofcode" : `aoc${entry.year}`}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 rounded-lg border border-border bg-surface px-4 py-2 text-sm transition-colors hover:border-accent"
          >
            <span class="font-semibold text-text-primary">{entry.year}</span>
            <span class="text-text-secondary">{entry.lang}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
