---
import type { Lang } from "@/data/resume";
import { education, nav } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="education" class="px-6 py-24">
  <div class="mx-auto max-w-3xl">
    <h2 class="mb-12 font-heading text-3xl">
      {nav[lang].education}
    </h2>

    <div class="space-y-8">
      {education.map((edu) => (
        <div>
          <p class="mb-1 text-xs font-medium tracking-wide text-text-secondary uppercase">
            {edu.period}
          </p>
          <h3 class="text-lg font-semibold text-text-primary">
            {edu.degree[lang]}
          </h3>
          <p class="text-sm font-medium text-accent">
            {edu.institution}
          </p>
          {edu.description && (
            <p class="mt-2 text-sm text-text-secondary">
              {edu.description[lang]}
            </p>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
