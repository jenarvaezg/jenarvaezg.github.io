---
import type { Lang } from "@/data/resume";
import { meta, hero, ui, careerMilestones } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = hero[lang];
const t = ui[lang];

// Presentation-only geometry for the career chart (560x240 viewBox).
const series =
  "6,212 24,208 40,213 58,204 76,207 94,198 112,201 126,192 140,186 " +
  "158,190 176,178 194,170 210,175 228,163 246,166 262,152 280,144 300,130 " +
  "316,136 334,122 352,112 368,117 386,102 404,94 418,99 430,88 " +
  "446,80 460,84 478,68 494,58 508,62 524,44 548,30";

const milestones = [
  { x: 6, y: 212, tx: 6, ty: 230, anchor: "start" },
  { x: 140, y: 186, tx: 140, ty: 206, anchor: "middle" },
  { x: 300, y: 130, tx: 300, ty: 108, anchor: "middle" },
  { x: 430, y: 88, tx: 430, ty: 68, anchor: "middle" },
  { x: 548, y: 30, tx: 548, ty: 14, anchor: "end" },
].map((geo, i) => ({
  ...geo,
  year: careerMilestones[i].year,
  label: careerMilestones[i].label[lang],
}));
---

<section class="px-6 pt-28 pb-14 sm:pt-36 sm:pb-20">
  <div class="mx-auto grid w-full max-w-4xl items-center gap-10 lg:grid-cols-[1fr_1.15fr]">
    <div>
      <p class="mb-5 font-mono text-xs tracking-widest text-ink-soft uppercase">
        jenarvaezg · {meta.location}
      </p>
      <h1 class="mb-3 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">
        {meta.name}
      </h1>
      <p class="mb-2 font-mono text-sm font-medium text-market uppercase tracking-wide">
        {content.title}
      </p>
      <p class="mb-8 max-w-md text-base leading-relaxed text-ink-soft">
        {content.subtitle}
      </p>
      <div class="flex flex-wrap gap-3">
        <a
          href={meta.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-[3px] bg-ink px-4 py-2.5 font-mono text-xs font-medium tracking-wider text-paper uppercase transition-colors hover:bg-market"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"></path></svg>
          GitHub
        </a>
        <a
          href={meta.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-[3px] border border-rule px-4 py-2.5 font-mono text-xs font-medium tracking-wider uppercase transition-colors hover:border-market hover:text-market"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:${meta.email}`}
          class="inline-flex items-center gap-2 rounded-[3px] border border-rule px-4 py-2.5 font-mono text-xs font-medium tracking-wider uppercase transition-colors hover:border-market hover:text-market"
        >
          Email
        </a>
        <a
          href="/cv.pdf"
          download
          class="inline-flex items-center gap-2 rounded-[3px] border border-rule px-4 py-2.5 font-mono text-xs font-medium tracking-wider uppercase transition-colors hover:border-market hover:text-market"
        >
          {t.downloadCV}
        </a>
      </div>
    </div>

    <figure class="w-full">
      <svg
        viewBox="0 0 560 240"
        class="w-full"
        role="img"
        aria-label={t.chartCaption}
      >
        {/* chart-paper grid */}
        {[68, 136, 204, 272, 340, 408, 476, 544].map((x) => (
          <line x1={x} y1="0" x2={x} y2="240" stroke="var(--color-rule)" stroke-width="0.5" opacity="0.55" />
        ))}
        {[40, 80, 120, 160, 200].map((y) => (
          <line x1="0" y1={y} x2="560" y2={y} stroke="var(--color-rule)" stroke-width="0.5" opacity="0.55" />
        ))}

        <polyline
          points={series}
          fill="none"
          stroke="var(--color-market)"
          stroke-width="2"
          stroke-linejoin="round"
          stroke-linecap="round"
          pathLength="1000"
          class="worth-line"
        />

        {milestones.map((m, i) => (
          <g class="worth-dot" style={`animation-delay: ${0.5 + i * 0.3}s`}>
            <circle
              cx={m.x}
              cy={m.y}
              r="3.5"
              fill="var(--color-market)"
              class={i === milestones.length - 1 ? "worth-dot-pulse" : ""}
            />
            <text
              x={m.tx}
              y={m.ty}
              text-anchor={m.anchor}
              class="hidden sm:block"
              font-family="var(--font-mono)"
              font-size="10"
              fill="var(--color-ink-soft)"
            >
              {m.year} · {m.label}
            </text>
          </g>
        ))}
      </svg>
      <figcaption class="mt-2 text-right font-mono text-xs text-ink-soft">
        {t.chartCaption}
      </figcaption>
    </figure>
  </div>
</section>
