---
import type { Lang } from "@/data/resume";
import { about, nav } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="about" class="px-6 py-24">
  <div class="mx-auto max-w-3xl animate-on-scroll">
    <h2 class="mb-2 text-sm font-medium tracking-widest text-accent-blue uppercase">
      {nav[lang].about}
    </h2>
    <div class="mb-8 h-1 w-12 rounded-full bg-gradient-to-r from-accent-blue to-accent-violet"></div>
    <p class="text-lg leading-relaxed text-text-secondary">
      {about[lang]}
    </p>
  </div>
</section>
