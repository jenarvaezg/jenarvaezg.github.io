---
import type { Lang } from "@/data/resume";
import { nav } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = nav[lang];
const otherLang = lang === "en" ? "es" : "en";
const otherLangUrl = lang === "en" ? "/es/" : "/";
---

<header id="header" class="fixed top-0 z-50 w-full border-b border-transparent bg-[#0c0a09]/80 backdrop-blur-lg transition-colors duration-300">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={lang === "en" ? "/" : "/es/"} class="font-heading text-xl text-accent">
      JE
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {Object.entries(labels).map(([key, label]) => (
        <a
          href={`#${key}`}
          class="text-sm text-text-secondary transition-colors hover:text-text-primary"
        >
          {label}
        </a>
      ))}
      <a
        href={otherLangUrl}
        class="ml-2 rounded-full border border-border px-3 py-1 text-xs font-medium text-text-secondary transition-colors hover:border-accent hover:text-text-primary"
      >
        {otherLang.toUpperCase()}
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Toggle menu"
    >
      <span class="block h-0.5 w-6 bg-text-primary transition-transform"></span>
      <span class="block h-0.5 w-6 bg-text-primary transition-opacity"></span>
      <span class="block h-0.5 w-6 bg-text-primary transition-transform"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-border md:hidden">
    <div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-6">
      {Object.entries(labels).map(([key, label]) => (
        <a
          href={`#${key}`}
          class="text-sm text-text-secondary transition-colors hover:text-text-primary"
        >
          {label}
        </a>
      ))}
      <a
        href={otherLangUrl}
        class="inline-flex w-fit rounded-full border border-border px-3 py-1 text-xs font-medium text-text-secondary transition-colors hover:border-accent hover:text-text-primary"
      >
        {otherLang.toUpperCase()}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const header = document.getElementById("header");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  menu?.querySelectorAll("a[href^='#']").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
    });
  });

  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      header?.classList.add("border-border");
    } else {
      header?.classList.remove("border-border");
    }
  });
</script>
