---
import type { Lang } from "@/data/resume";
import { nav } from "@/data/resume";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const labels = nav[lang];
const otherLang = lang === "en" ? "es" : "en";
const otherLangUrl = lang === "en" ? "/es/" : "/";
---

<header id="header" class="fixed top-0 z-50 w-full border-b border-transparent bg-paper/85 backdrop-blur-md transition-colors duration-300">
  <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-3.5">
    <a href={lang === "en" ? "/" : "/es/"} class="font-mono text-sm font-medium text-ink transition-colors hover:text-market">
      jenarvaezg<span class="text-market">/</span>
    </a>

    <nav class="hidden items-center gap-5 md:flex">
      {Object.entries(labels).map(([key, label]) => (
        <a
          href={`#${key}`}
          class="font-mono text-xs lowercase tracking-wide text-ink-soft transition-colors hover:text-ink"
        >
          {label}
        </a>
      ))}
      <a
        href={otherLangUrl}
        class="ml-1 rounded-[3px] border border-rule px-2.5 py-1 font-mono text-xs font-medium text-ink-soft transition-colors hover:border-market hover:text-market"
      >
        {otherLang.toUpperCase()}
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="flex flex-col gap-1.5 md:hidden"
      aria-label="Toggle menu"
    >
      <span class="block h-0.5 w-6 bg-ink transition-transform"></span>
      <span class="block h-0.5 w-6 bg-ink transition-opacity"></span>
      <span class="block h-0.5 w-6 bg-ink transition-transform"></span>
    </button>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-rule md:hidden">
    <div class="mx-auto flex max-w-4xl flex-col gap-4 px-6 py-6">
      {Object.entries(labels).map(([key, label]) => (
        <a
          href={`#${key}`}
          class="font-mono text-sm lowercase text-ink-soft transition-colors hover:text-ink"
        >
          {label}
        </a>
      ))}
      <a
        href={otherLangUrl}
        class="inline-flex w-fit rounded-[3px] border border-rule px-2.5 py-1 font-mono text-xs font-medium text-ink-soft transition-colors hover:border-market hover:text-market"
      >
        {otherLang.toUpperCase()}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const header = document.getElementById("header");

  toggle?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });

  menu?.querySelectorAll("a[href^='#']").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
    });
  });

  window.addEventListener("scroll", () => {
    if (window.scrollY > 20) {
      header?.classList.add("border-rule");
    } else {
      header?.classList.remove("border-rule");
    }
  });
</script>
